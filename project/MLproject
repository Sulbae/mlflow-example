name: latihan-cs-mlflow

docker_env: 
  image: sulbae/mlflow-env:latest

entry_points:
  train_fixed:
    parameters:
      n_estimators: {type: int, default: 505}
      max_depth: {type: int, default: 35}
      dataset: {type: str, default: "train_pca.csv"}
    command: >
      python modelling.py 
      --n_estimators {n_estimators} 
      --max_depth {max_depth} 
      --dataset {dataset}
  
  train_tuning:
    parameters:
      dataset: {type: str, default: "train_pca.csv"}
    command: >
      python modellingopt.py
      --dataset {dataset}